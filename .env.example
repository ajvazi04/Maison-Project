DOMAIN=shop.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional: leave blank to use cash on delivery only.
PAYPAL_MODE=Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: required to send password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Maison
SMTP_ENABLE_SSL=true
